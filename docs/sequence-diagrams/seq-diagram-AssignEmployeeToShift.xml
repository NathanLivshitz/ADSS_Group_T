        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    participant Manager\n    participant Employee\n    participant Shift\n    participant ShiftAssignment\n\n    Manager-&gt;&gt;Manager: assignEmployeeToShift(id, role, shift, isOverride)\n\n    Manager-&gt;&gt;Manager: validateInput(id, role, shift)\n\n    alt invalid input\n        Manager--&gt;&gt;Manager: throw \&quot;invalid input\&quot;\n    else input is valid\n        Manager-&gt;&gt;Manager: searchEmployee(id)\n        Manager--&gt;&gt;Manager: employee\n    end\n\n    Manager-&gt;&gt;Manager: validateEmployee(employee, role)\n\n    alt employee validation failed\n        Manager--&gt;&gt;Manager: throw relevant employee error\n        Note right of Manager: employee does not exist / inactive / not qualified for role\n    else employee is valid\n        Manager-&gt;&gt;Shift: getDay()\n        Shift--&gt;&gt;Manager: day\n        Manager-&gt;&gt;Manager: validateShiftAndRole(shift, role, day)\n    end\n\n    alt shift or role validation failed\n        Manager--&gt;&gt;Manager: throw relevant shift or role error\n        Note right of Manager: shift does not exist / closed day / no shift manager / role not required or full\n    else shift and role are valid\n        Manager-&gt;&gt;Manager: validateAssignment(employee, shift, isOverride)\n    end\n\n    alt assignment validation failed\n        Manager--&gt;&gt;Manager: throw relevant assignment error\n        Note right of Manager: employee already assigned / not available without override\n    else assignment is valid\n        Manager-&gt;&gt;ShiftAssignment: create(employee, shift, role)\n        ShiftAssignment--&gt;&gt;Manager: assignment\n        Manager-&gt;&gt;Manager: assignments.add(assignment)\n    end\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="gduojRd2UQT58nA83U-v-2">
